@model List<LibroDTO>
@{
}
<div class="d-flex flex-column justify-content-start align-items-stretch">
    <div class="text-end mb-3">
        <button type="button" class="btn btn-outline-info" onclick="bookEdit()">
            <i class="fa-solid fa-plus fa-lg"></i>
            Nuovo
        </button>
    </div>
    <table id="authorList" class="table table-hover table-responsive">
        <thead>
            <tr>
                <th width="50"> </th>
                <th>Titolo</th>
                <th>Autore</th>
                <th width="125">Nr. prest.</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Count > 0)
            {
                foreach (var m in Model)
                {
                    <tr>
                        <td width="50">
                            <i class="fa-solid fa-user-edit fa-xl ms-2 c-pointer" onclick="bookEdit(@m.Id)"></i>
                        </td>
                        <td>
                            @m.Titolo
                            @if (!string.IsNullOrWhiteSpace(m.Trama))
                            {
                                <small class="d-block">
                                    <em>
                                        @m.Trama
                                    </em>
                                </small>
                            }
                        </td>
                        <td>
                            @m.AutoreNome @m.AutoreCognome
                        </td>
                        <td width="125">
                            @m.NrCopieInPrestito
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        <em>
                            Nessun risultato
                        </em>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById('modalGlobal').addEventListener('hide.bs.modal', event => {
            location.reload();
        });
    </script>
}