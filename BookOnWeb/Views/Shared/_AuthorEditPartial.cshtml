@model AutoreDTO
@{
}

<div class="--loader" id="loaderAuthorEdit">
    <div class="spinner-border spinner-border-xxl text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<form id="authorForm" name="authorForm" method="post" asp-antiforgery="true">
    <input asp-for="Id" type="hidden" />
    <input asp-for="NrLibri" type="hidden" />


    <fieldset class="--fieldset-form">
        
        <div class="my-3">
            <label asp-for="Nome" class="form-label">Nome<sup class="text-danger">*</sup></label>
            <input asp-for="Nome" class="form-control" />
        </div>
        <div class="my-3">
            <label asp-for="Cognome" class="form-label">Cognome<sup class="text-danger">*</sup></label>
            <input asp-for="Cognome" class="form-control" />
        </div>
    
        <hr />
        <div class="d-flex flex-row justify-content-between align-items-center mb-3">
            <div class="col-sm text-secondary">
                <small>
                    <em>
                        Nr. libri all&rsquo;attivo <strong>@Model.NrLibri</strong>
                    </em>
                </small>
            </div>
            <div>
                <button type="reset" class="btn btn-outline-dark ms-3">Annulla</button>
                <button type="button" class="btn btn-primary ms-3" onclick="salvaAutore(event)">Salva</button>
            </div>
        </div>

    </fieldset>

</form>

<script>
    function salvaAutore(evt) {
        if (evt) evt.preventDefault();

        let _form = $('#authorForm').serialize();
        $('#loaderAuthorEdit').show();
        $.ajax({
            url:'/author/edit',
            method:'post',
            data: _form,
            success: (res) => {
                $('#loaderAuthorEdit').hide();
                if (!!res && res.succeeded == true) {
                    Swal.fire({
                        title: 'Eureka!',
                        text: 'Salvataggio effettuato!',
                        icon: 'success',
                        confirmButtonText: 'Chiudi'
                    });
                } else {
                    Swal.fire({
                        title: 'Oops...',
                        text: 'Si è verificato un errore! ' + res.message,
                        icon: 'error',
                        confirmButtonText: 'Chiudi'
                    });
                }
            },
            error: (err) => {
                console.log(err);
                $('#loaderAuthorEdit').hide();
                Swal.fire({
                    title: 'Oops...',
                    text: 'Si è verificato un errore!',
                    icon: 'error',
                    confirmButtonText: 'Chiudi'
                });
            }
        });
    }

    $(function(){
        $('#loaderAuthorEdit').hide();
    })
</script>
