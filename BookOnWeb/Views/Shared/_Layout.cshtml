<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookOnWeb</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/svg+xml" href="~/favicon/favicon.svg" />
    <link rel="shortcut icon" href="~/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/favicon/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-title" content="BookOnWeb" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon/favicon-96x96.png">
    <link rel="manifest" href="~/favicon/site.webmanifest">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BookOnWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Book" asp-action="Index">Libri</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Author" asp-action="Index">Autori</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Sharing" asp-action="Index">Prestiti</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <div class="modal fade" id="modalGlobal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <!-- Modal Header -->
                    <div class="modal-header" id="modalHeader">
                        <h4 class="modal-title me-auto" id="modalTitle"></h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <!-- Modal body -->
                    <div class="modal-body" id="modalBody"></div>
                    <!-- Modal footer -->
                    <div class="modal-footer" id="modalFooter">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BookOnWeb <em>by Riccardo Sadocchi</em>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>

        document.getElementById('modalGlobal').addEventListener('hidden.bs.modal', event => {
            $('#modalTitle').html('');
            $('#modalBody').html('');
        });

        function bookEdit(id) {
            $.ajax({
                url:`/book/edit/${(!!id && +id || 0)}`,
                method:'get',
                success: (data) => {
                    $('#modalTitle').html('Nuovo Libro');
                    $('#modalFooter').hide();
                    $('#modalBody').html(data);
                    $('#modalGlobal').modal('show');
                },
                error: (error) => {
                    Swal.fire({
                        title: 'Oops...',
                        text: 'Si è verificato un errore',
                        icon: 'error',
                        confirmButtonText: 'Chiudi'
                    });
                }
            });
        }

        function authorEdit(id) {
            $.ajax({
                url:`/author/edit/${(!!id && +id || 0)}`,
                method:'get',
                success: (data) => {
                    $('#modalTitle').html('Nuovo Autore');
                    $('#modalFooter').hide();
                    $('#modalBody').html(data);
                    $('#modalGlobal').modal('show');
                },
                error: (error) => {
                    Swal.fire({
                        title: 'Oops...',
                        text: 'Si è verificato un errore',
                        icon: 'error',
                        confirmButtonText: 'Chiudi'
                    });
                }
            });
        }

        function sharingEdit(id) {
            $.ajax({
                url:`/sharing/edit/${(!!id && +id || 0)}`,
                method:'get',
                success: (data) => {
                    $('#modalTitle').html('Nuovo prestito');
                    $('#modalFooter').hide();
                    $('#modalBody').html(data);
                    $('#modalGlobal').modal('show');
                },
                error: (error) => {
                    Swal.fire({
                        title: 'Oops...',
                        text: 'Si è verificato un errore',
                        icon: 'error',
                        confirmButtonText: 'Chiudi'
                    });
                }
            });
        }


    </script>
</body>
</html>
