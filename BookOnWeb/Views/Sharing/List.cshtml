@model List<PrestitoDTO>
@{
}
<div class="d-flex flex-column justify-content-start align-items-stretch">
    <div class="d-flex flex-row justify-content-between align-items-center">
        <div class="col-sm d-flex flex-row justify-content-start align-items-center">
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro1" value="true" checked>
                <label class="form-check-label" for="radioFiltro1">
                    Aperti
                </label>
            </div>
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro2" value="false">
                <label class="form-check-label" for="radioFiltro2">
                    Chiusi
                </label>
            </div>
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro1" value="">
                <label class="form-check-label" for="radioFiltro1">
                    Tutti
                </label>
            </div>
        </div>
        <div class="text-end mb-3">
            <button type="button" class="btn btn-outline-info" onclick="sharingEdit()">
                <i class="fa-solid fa-plus fa-lg"></i>
                Nuovo
            </button>
        </div>
    </div>
    <table id="authorList" class="table table-hover table-responsive">
        <thead>
            <tr>
                <th width="50"> </th>
                <th>Titolo</th>
                <th>Persona</th>
                <th width="125">Data</th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Count > 0)
            {
                foreach (var m in Model)
                {
                    <tr>
                        <td width="50">
                            <i class="fa-solid fa-user-edit fa-xl ms-2 c-pointer" onclick="sharingEdit(@m.Id)"></i>
                        </td>
                        <td>
                            @m.TitoloLibro
                            <small class="d-block">
                                <em>
                                    di @m.NomeCompletoAutore
                                </em>
                            </small>
                        </td>
                        <td>
                            <span>@m.NomeUtente</span>
                            <span class="d-block">@m.Cellulare</span>
                            @if (!string.IsNullOrWhiteSpace(m.Email))
                            {
                                <span class="d-block">
                                    <a href="mailto:@m.Email" target="_blank">@m.Email</a>
                                </span>
                            }
                        </td>
                        <td width="125">
                            <span class="d-block">Prestato @m.DataPrestito.ToString("ddd dd MMM yyyy")</span>
                            @if (m.DataRestituzione.HasValue)
                            {
                                <span class="d-block">Restituito @m.DataRestituzione.GetValueOrDefault().ToString("ddd dd MMM yyyy")</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        <em>
                            Nessun risultato
                        </em>
                    </td>
                </tr>
            }

        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById('modalGlobal').addEventListener('hide.bs.modal', event => {
            location.reload();
        });
    </script>
}