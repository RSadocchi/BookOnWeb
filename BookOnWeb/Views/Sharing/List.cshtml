@{
}
<div class="d-flex flex-column justify-content-start align-items-stretch">
    <div class="d-flex flex-row justify-content-between align-items-center">
        <div class="col-sm d-flex flex-row justify-content-start align-items-center">
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro1" value="true" onchange="filtraPag(true)" checked>
                <label class="form-check-label" for="radioFiltro1">
                    Aperti
                </label>
            </div>
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro2" value="false" onchange="filtraPag(false)">
                <label class="form-check-label" for="radioFiltro2">
                    Chiusi
                </label>
            </div>
            <div class="form-check col-sm-1">
                <input class="form-check-input" type="radio" name="radioFiltro" id="radioFiltro1" value="" onchange="filtraPag('')">
                <label class="form-check-label" for="radioFiltro1">
                    Tutti
                </label>
            </div>
        </div>
        <div class="text-end mb-3">
            <button type="button" class="btn btn-outline-info" onclick="sharingEdit()">
                <i class="fa-solid fa-plus fa-lg"></i>
                Nuovo
            </button>
        </div>
    </div>
    <table id="sharedList" class="table table-hover table-responsive">
        <thead>
            <tr>
                <th width="50"> </th>
                <th>Titolo</th>
                <th>Persona</th>
                <th>Data</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        document.getElementById('modalGlobal').addEventListener('hide.bs.modal', event => {
            location.reload();
        });

        function filtraPag(v) {
            $.ajax({
                url: `/sharing/table?aperti=${v}`,
                method: 'get',
                success: (data) => {
                    $('#sharedList tbody').html(data);
                },
                error: (error) => {
                    Swal.fire({
                        title: 'Oops...',
                        text: 'Si è verificato un errore',
                        icon: 'error',
                        confirmButtonText: 'Chiudi'
                    });
                }
            });
        }

        $(function(){
            filtraPag();
        });
    </script>
}